<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="@color/widget_surface">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_text" android:textSize="16sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_content" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" android:textColor="@color/widget_text" android:textSize="16sp" />
    <Button android:id="@+id/widget_action" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:textSize="14sp" android:textAllCaps="false" android:textColor="@color/widget_on_accent" android:background="@drawable/widget_action_background" android:backgroundTint="@color/widget_accent" android:text="@string/widget_open" />
</LinearLayout>
